  {
    "id": "ore_crude_matter",
    "category": "ore",
    "title": "Crude Matter",
    "game_id": null,
    "content": "Braids of serenity and power entwine and disperse across the surface. Within, they dance as if begging to be set free. From this rhythm, the dreams of those long passed and those newly awoken may spring forth.\r\n\r\nA quiet fragility eminates from the matter\u2019s movements, the ethereal beauty of transience. Practicality has no need of such things.",
    "tags": "crude matter,rift,rare,valuable,ore",
    "aliases": "crude matter,rift ore"
  },
  {
    "id": "ore_char",
    "category": "ore",
    "title": "Char belt ores",
    "game_id": null,
    "content": "Calcium-sodium aluminosilicate feldspar crystals from basaltic crust of differentiated asteroids.\r\n\r\nFeldspar Crystals are commonly found in <a href=\"showinfo:91374\">Char </a>asteroids.",
    "tags": "char,feldspar,belt ore,common",
    "aliases": "char ore,feldspar crystals"
  },
  {
    "id": "ore_slag",
    "category": "ore",
    "title": "Slag belt ores",
    "game_id": null,
    "content": "Platinum and palladium concentrated in nickel-rich metallic grains from intermediate core zones. Forms during slow cooling of differentiated asteroid cores.\r\n\r\nPlatinum-Palladium Matrix is commonly found in  <a href=\"showinfo:91375\">Slag</a> asteroids.",
    "tags": "slag,platinum,palladium,belt ore",
    "aliases": "slag ore,platinum-palladium matrix"
  },
  {
    "id": "ore_ingot",
    "category": "ore",
    "title": "Ingot belt ores",
    "game_id": null,
    "content": "Dense iridium-osmium-ruthenium alloy nodules from the deepest, hottest core regions. Among the most refractory materials in the solar system.\r\n\r\nIridosmine Nodules are commonly found in <a href=\"showinfo:91376\">Ingot asteroids</a>.",
    "tags": "ingot,iridosmine,belt ore",
    "aliases": "ingot ore,iridosmine nodules"
  },
  {
    "id": "ore_comet",
    "category": "ore",
    "title": "Comet belt ores",
    "game_id": null,
    "content": "Water-bearing sulfide-rich material common in carbonaceous chondrites. Represents aqueous alteration of metal sulfides in the early solar system.\r\n\r\nHydrated Sulfide Matrix is commonly found in <a href=\"showinfo:91377\">Comet</a> asteroids.",
    "tags": "comet,hydrated sulfide,belt ore",
    "aliases": "comet ore,hydrated sulfide matrix"
  },
  {
    "id": "ore_dewdrop",
    "category": "ore",
    "title": "Dewdrop belt ores",
    "game_id": null,
    "content": "Pure methane ice preserved at cryogenic temperatures in outer asteroid belt regions.\r\n\r\nMethane Ice Shards are commonly found in <a href=\"showinfo:91378\">Dewdrop</a> asteroids.",
    "tags": "dewdrop,methane ice,belt ore,ice",
    "aliases": "dewdrop ore,methane ice shards"
  },
  {
    "id": "ore_ember",
    "category": "ore",
    "title": "Ember belt ores",
    "game_id": null,
    "content": "Unaltered complex organic polymer preserved from early solar system formation, less processed than C-type kerogen.\r\n\r\nPrimitive Kerogen Matrix is commonly found in <a href=\"showinfo:91379\">Ember</a> asteroids.",
