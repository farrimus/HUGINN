# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# EVE FRONTIER COMPANION — MINIMAL CONFIGURATION
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# DEPLOYMENT & NETWORK
# Choose one: utopia (testnet) or stillness (staging)
# System auto-selects RPC URL, World API URL, and package IDs
DEPLOYMENT_ENV=utopia

# AI & APIs
# Get from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# AUTHENTICATION & SECURITY
# Generate: python -c "import secrets; print(secrets.token_hex(16))"
JWT_SECRET=your-random-secret-here

# Generate: python -c "import secrets; print(secrets.token_hex(8))"
TOKEN_KEY_PASSWORD=your-password-here

# SERVER WALLET
# Your Sui wallet address (0x-prefixed)
VPS_SUI_ADDRESS=0xyour-sui-wallet-address-here

# OPTIONAL: Server port (default: 8745)
# PORT=8745

# LEGACY: Only needed if using old log-agent auth (deprecated)
SERVER_TOKEN=5740edb0fb25a051db4a932c3622bd69ce47d487bc501f2bde4cb7e19907c454
